# ─── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Firebase Admin SDK ───────────────────────────────
# Go to Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Supabase ─────────────────────────────────────────
# Free at: https://supabase.com — create a project, copy keys from Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Cloudinary (Image Storage - Free 25GB) ───────────
# Free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── OpenAI ───────────────────────────────────────────
# User can supply their own key via the app settings
OPENAI_API_KEY=sk-...

# ─── Groq (FREE AI - for basic tier) ─────────────────
# Free at: https://console.groq.com — 14,400 req/day free
GROQ_API_KEY=gsk_...
